<?xml version="1.0" encoding="UTF-8"?>
<regras>

  <regra id="R1" perfil="estudante">
    <condicao campo="tipo_documento" operador="=" valor="livro"/>
    <condicao campo="n_emprestimos_ativos" operador="&lt;" valor="5" unidade="documentos"/>
    <prazo valor="15" unidade="dias_corridos"/>
  </regra>

  <regra id="R2" perfil="docente">
    <condicao campo="categoria" operador="=" valor="geral"/>
    <condicao campo="tipo_documento" operador="=" valor="livro"/>
    <condicao campo="n_emprestimos_ativos" operador="&lt;" valor="5" unidade="documentos"/>
    <prazo valor="60" unidade="dias_corridos"/>
    <multa aplica="nao"/>
    <excecao>
      <condicao campo="categoria" operador="=" valor="reserva"/>
      <condicao campo="tipo_documento" operador="=" valor="livro"/>
      <condicao campo="n_emprestimos_ativos" operador="&lt;" valor="5" unidade="documentos"/>
      <condicao campo="n_emprestimos_reserva_ativos" operador="&lt;" valor="3" unidade="documentos"/>
      <prazo valor="3" unidade="dias_corridos"/>
      <multa aplica="sim"/>
    </excecao>
  </regra>

  <regra id="R3">
    <condicao campo="perfil" operador="=" valor="estudante"/>
    <condicao campo="categoria" operador="em" valor="geral reserva"/>
    <condicao campo="dias_atraso" operador="&gt;=" valor="3" unidade="dias_corridos"/>
    <multa aplica="sim" valor="0.50" unidade="EUR_por_dia" dias_cobrados="dias_atraso - 2"/>
    <excecao>
      <condicao campo="perfil" operador="=" valor="docente"/>
      <condicao campo="categoria" operador="=" valor="reserva"/>
      <condicao campo="dias_atraso" operador="&gt;=" valor="3" unidade="dias_corridos"/>
      <multa aplica="sim" valor="0.50" unidade="EUR_por_dia" dias_cobrados="dias_atraso - 2"/>
    </excecao>
    <limite_anual campo="total_multas_ano" operador="&gt;=" valor="100" unidade="EUR" consequencia="bloquear_requisicoes_ate_fim_ano_letivo"/>
  </regra>

  <regra id="R4">
    <condicao campo="perfil" operador="em" valor="docente estudante"/>
    <condicao campo="autorizado" operador="=" valor="verdadeiro"/>
    <condicao campo="categoria" operador="=" valor="rara"/>
    <condicao campo="tipo_documento" operador="em" valor="livro manuscrito"/>
    <condicao campo="local" operador="=" valor="sala_de_leitura"/>
    <requisicao permitida="nao"/>
  </regra>

</regras>
